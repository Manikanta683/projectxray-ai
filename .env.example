# ProjectX-Ray environment configuration
# Add secrets locally in .env. Never commit real secrets.

APP_ENV=development
APP_NAME=ProjectX-Ray

# Frontend -> FastAPI backend
PROJECTXRAY_API_URL=http://127.0.0.1:8000

# Enhanced recommendation provider
# auto = Gemini first, then OpenAI; rule-based fallback if neither is configured
RECOMMENDATION_PROVIDER=auto
GEMINI_MODEL=gemini-3.7-flash
OPENAI_MODEL=gpt-5-mini

# Put the real key only in your local .env or Render environment variables.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
